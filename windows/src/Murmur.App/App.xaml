<Application
    x:Class="Murmur.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="MurmurPaper" Color="#FAFAFA" />
                    <SolidColorBrush x:Key="MurmurSidebar" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="MurmurInk" Color="#202020" />
                    <SolidColorBrush x:Key="MurmurMuted" Color="#555555" />
                    <SolidColorBrush x:Key="MurmurRule" Color="#DEDEDE" />
                    <SolidColorBrush x:Key="MurmurSelection" Color="#EEEEEE" />
                    <SolidColorBrush x:Key="MurmurAccent" Color="#4D6FF0" />
                    <SolidColorBrush x:Key="MurmurAccentWash" Color="#1F4D6FF0" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#D6D6D6" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#BDBDBD" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#D6D6D6" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#BDBDBD" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="#D6D6D6" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="#BDBDBD" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="MurmurPaper" Color="#181818" />
                    <SolidColorBrush x:Key="MurmurSidebar" Color="#111111" />
                    <SolidColorBrush x:Key="MurmurInk" Color="#FAFAFA" />
                    <SolidColorBrush x:Key="MurmurMuted" Color="#BBBBBB" />
                    <SolidColorBrush x:Key="MurmurRule" Color="#393939" />
                    <SolidColorBrush x:Key="MurmurSelection" Color="#242424" />
                    <SolidColorBrush x:Key="MurmurAccent" Color="#4D6FF0" />
                    <SolidColorBrush x:Key="MurmurAccentWash" Color="#334D6FF0" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#4A4A4A" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#6A6A6A" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#4A4A4A" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#6A6A6A" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="#4A4A4A" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="#6A6A6A" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="MurmurPaper" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="MurmurSidebar" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="MurmurInk" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="MurmurMuted" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="MurmurRule" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="MurmurSelection" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="MurmurAccent" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="MurmurAccentWash" Color="{ThemeResource SystemColorWindowColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#4D6FF0" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#4D6FF0" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#4D6FF0" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#4D6FF0" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#4D6FF0" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#4D6FF0" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill" Color="#4D6FF0" />
            <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="#4D6FF0" />
            <Style x:Key="MurmurCard" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource MurmurSidebar}" />
                <Setter Property="BorderBrush" Value="{ThemeResource MurmurRule}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12" />
            </Style>
            <Style x:Key="MurmurDescription" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{ThemeResource MurmurMuted}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="MurmurCaption" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource MurmurMuted}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="MurmurRuleLine" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource MurmurRule}" />
            </Style>
            <Style x:Key="MurmurRuleTopStrong" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource MurmurMuted}" />
            </Style>
            <Style x:Key="MurmurRuleTop" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource MurmurRule}" />
            </Style>
            <Style x:Key="MurmurHeading" TargetType="TextBlock">
                <Setter Property="FontSize" Value="25" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Foreground" Value="{ThemeResource MurmurInk}" />
            </Style>
            <Style x:Key="MurmurSection" TargetType="TextBlock" BasedOn="{StaticResource MurmurCaption}">
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="CharacterSpacing" Value="80" />
            </Style>
            <Style x:Key="MurmurEyebrow" TargetType="TextBlock" BasedOn="{StaticResource MurmurSection}">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{ThemeResource MurmurAccent}" />
            </Style>
            <Style x:Key="MurmurAccentCard" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource MurmurAccentWash}" />
                <Setter Property="BorderBrush" Value="{ThemeResource MurmurAccent}" />
                <Setter Property="BorderThickness" Value="3,0,0,0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="16" />
            </Style>
            <Style x:Key="MurmurAccentText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource MurmurAccent}" />
            </Style>
            <Style x:Key="MurmurTrack" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource MurmurRule}" />
            </Style>
            <Style x:Key="MurmurBar" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource MurmurAccent}" />
            </Style>
            <Style x:Key="MurmurAccentCardFlat" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource MurmurAccentWash}" />
            </Style>
            <Style x:Key="MurmurPillWhite" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#FFFFFF" />
            </Style>
            <Style x:Key="MurmurPillFilled" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource MurmurInk}" />
            </Style>
            <Style x:Key="MurmurPillOutline" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource MurmurInk}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style x:Key="MurmurPillText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource MurmurPaper}" />
            </Style>
            <Style x:Key="MurmurSectionInk" TargetType="TextBlock" BasedOn="{StaticResource MurmurSection}">
                <Setter Property="Foreground" Value="{ThemeResource MurmurInk}" />
            </Style>
            <Style x:Key="MurmurSettingLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{ThemeResource MurmurInk}" />
            </Style>
            <Style x:Key="MurmurTranscript" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="ms-appx:///Fonts/DMSans.ttf#DM Sans" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Foreground" Value="{ThemeResource MurmurInk}" />
            </Style>
            <Style x:Key="MurmurHistoryEmpty" TargetType="TextBlock" BasedOn="{StaticResource MurmurTranscript}">
                <Setter Property="FontSize" Value="26" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="MurmurTrayMenu" TargetType="MenuFlyoutPresenter">
                <Setter Property="Background" Value="{ThemeResource MurmurPaper}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="5" />
            </Style>
            <Style x:Key="MurmurBubble" TargetType="Border" BasedOn="{StaticResource MurmurCard}">
                <Setter Property="Background" Value="{ThemeResource MurmurPaper}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="22" />
                <Setter Property="Padding" Value="5,2" />
            </Style>
            <Style x:Key="MurmurSidebarPane" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource MurmurSidebar}" />
                <Setter Property="BorderBrush" Value="{ThemeResource MurmurRule}" />
                <Setter Property="BorderThickness" Value="0,0,1,0" />
            </Style>
            <Style x:Key="MurmurWindowRoot" TargetType="Grid">
                <Setter Property="Background" Value="{ThemeResource MurmurPaper}" />
            </Style>
            <Style x:Key="MurmurNavOn" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource MurmurSelection}" />
            </Style>
            <Style x:Key="MurmurNavOff" TargetType="Border">
                <Setter Property="Background" Value="Transparent" />
            </Style>
            <Style x:Key="MurmurTabOff" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource MurmurMuted}" />
            </Style>
            <Style x:Key="MurmurMutedIcon" TargetType="FontIcon">
                <Setter Property="Foreground" Value="{ThemeResource MurmurMuted}" />
            </Style>
            <Style x:Key="MurmurAccentIcon" TargetType="FontIcon">
                <Setter Property="Foreground" Value="{ThemeResource MurmurAccent}" />
            </Style>
            <Style x:Key="MurmurBubbleDot" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource MurmurAccent}" />
            </Style>
            <Style x:Key="MurmurBubbleError" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
