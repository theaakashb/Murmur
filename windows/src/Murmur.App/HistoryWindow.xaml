<Window
    x:Class="Murmur.App.HistoryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid RowDefinitions="Auto,Auto,*">
        <TitleBar x:Name="Caption" Title="Murmur History" AutomationProperties.Name="Murmur History title bar" />
        <StackPanel Grid.Row="1" Spacing="4" Padding="24,16,24,16">
            <TextBlock Text="History" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock x:Name="Summary" Style="{StaticResource MurmurDescription}" />
            <InfoBar x:Name="Status" Severity="Error" IsClosable="True" AutomationProperties.Name="History status" />
        </StackPanel>
        <ScrollViewer Grid.Row="2" AutomationProperties.Name="Dictation history">
            <StackPanel x:Name="Entries" Spacing="8" Padding="24,0,24,24" />
        </ScrollViewer>
    </Grid>
</Window>
