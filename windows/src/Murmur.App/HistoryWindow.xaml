<Window
    x:Class="Murmur.App.HistoryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowDefinitions="Auto,Auto,*" Background="{ThemeResource MurmurPaper}">
        <TitleBar x:Name="Caption" Title="Murmur History" AutomationProperties.Name="Murmur History title bar" />
        <StackPanel Grid.Row="1" Spacing="12" Padding="24,16,24,16">
            <TextBlock Text="History" FontFamily="ms-appx:///Fonts/InstrumentSerif-Regular.ttf#Instrument Serif" FontSize="64" CharacterSpacing="-20" Foreground="{ThemeResource MurmurInk}" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock x:Name="Summary" Style="{StaticResource MurmurDescription}" />
            <InfoBar x:Name="Status" Severity="Error" IsClosable="True" AutomationProperties.Name="History status" />
        </StackPanel>
        <Border Grid.Row="2" BorderBrush="{ThemeResource MurmurRule}" BorderThickness="0,1,0,0">
            <ScrollViewer AutomationProperties.Name="Dictation history">
                <StackPanel x:Name="Entries" Padding="24,0,24,24" />
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
