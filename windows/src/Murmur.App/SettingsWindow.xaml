<Window
    x:Class="Murmur.App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid RowDefinitions="Auto,*">
        <TitleBar x:Name="Caption" Title="Murmur Settings" AutomationProperties.Name="Murmur Settings title bar" />
        <NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            AutomationProperties.Name="Settings navigation"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            AlwaysShowHeader="False"
            OpenPaneLength="188"
            ExpandedModeThresholdWidth="760"
            CompactModeThresholdWidth="560"
            SelectionChanged="SelectPane">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="General" AutomationProperties.Name="General" Icon="Setting" />
                <NavigationViewItem Content="Dictation" AutomationProperties.Name="Dictation" Icon="Microphone" />
                <NavigationViewItem Content="Writing" AutomationProperties.Name="Writing" Icon="Edit" />
                <NavigationViewItem Content="Privacy &amp; Storage" AutomationProperties.Name="Privacy and Storage" Icon="Save" />
                <NavigationViewItem Content="Providers" AutomationProperties.Name="Providers" Icon="Permissions" />
            </NavigationView.MenuItems>
            <ScrollViewer x:Name="PaneScroll" AutomationProperties.Name="Settings pane">
                <StackPanel Spacing="8" Padding="24,16,24,24" MaxWidth="840">
                    <TextBlock x:Name="PaneTitle" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock x:Name="PaneDescription" Style="{StaticResource MurmurDescription}" />
                    <SelectorBar x:Name="DictationTabs" AutomationProperties.Name="Dictation settings tabs"
                                 SelectionChanged="SelectDictationTab" Margin="0,4,0,4">
                        <SelectorBarItem Text="Recording" AutomationProperties.Name="Recording" />
                        <SelectorBarItem Text="Transcription" AutomationProperties.Name="Transcription" />
                        <SelectorBarItem Text="Insertion" AutomationProperties.Name="Insertion" />
                    </SelectorBar>
                    <ContentControl x:Name="PaneContent" HorizontalContentAlignment="Stretch" IsTabStop="False" Margin="0,8,0,0" />
                </StackPanel>
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Window>
