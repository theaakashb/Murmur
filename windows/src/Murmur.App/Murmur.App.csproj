<Project Sdk="Microsoft.NET.Sdk">
  <!-- The WinUI 3 tray app: unpackaged and self-contained, so users install no runtime. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Users install no runtime (PLAN.md): ship .NET with the app, as the helpers already do. -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <InvariantGlobalization>false</InvariantGlobalization>
    <RootNamespace>Murmur.App</RootNamespace>
    <AssemblyName>Murmur</AssemblyName>
    <!-- Program.cs owns Main so Velopack runs first. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.7.0" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <!-- Exact pin; the vpk tool in tools/package.ps1 must be the same version. -->
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Murmur.Core\Murmur.Core.csproj" />
    <ProjectReference Include="..\Murmur.Platform\Murmur.Platform.csproj" />
  </ItemGroup>
  <!-- Tray icons (tools/make_tray_icons.py): light and dark taskbar variants. -->
  <ItemGroup>
    <Content Include="Assets\tray-light.ico;Assets\tray-dark.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The logo on the "Murmur is ready" notification (from app/AppIcon.icns). -->
  <ItemGroup>
    <Content Include="Assets\murmur-logo.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Flag images for the dictation language picker (lipis/flag-icons, MIT; see Assets\Flags\README.md). -->
  <ItemGroup>
    <Content Include="Assets\Flags\*.svg;Assets\Flags\LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Shared editorial fonts and their SIL Open Font License notices. -->
  <ItemGroup>
    <Content Include="..\..\..\app\Fonts\InstrumentSerif-Regular.ttf;..\..\..\app\Fonts\DMSans.ttf"
             Link="Fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\..\app\Fonts\InstrumentSerif-OFL.txt;..\..\..\app\Fonts\DMSans-OFL.txt"
          Link="Fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Artifact pins for BundledModels (shared with the Mac), beside Murmur.exe. -->
  <ItemGroup>
    <None Include="..\..\..\module-one\models\artifact-pins.json" Link="artifact-pins.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The two helpers, each self-contained in its own subfolder so their native DLLs never clash: Speech\MurmurSpeech.exe and Cleanup\Murmur.Cleanup.exe.
       Published in-build (a ProjectReference to an exe cannot be self-contained from here); Publish of the app copies the subfolders along. -->
  <ItemGroup>
    <Helper Include="..\Murmur.Speech\Murmur.Speech.csproj" Folder="Speech" />
    <Helper Include="..\Murmur.Cleanup\Murmur.Cleanup.csproj" Folder="Cleanup" />
  </ItemGroup>
  <Target Name="PublishHelpers" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <!-- Keep old NuGet imports out of MSBuild's XML cache until restore has refreshed them. -->
    <MSBuild Projects="@(Helper)" Targets="Restore" Properties="Configuration=$(Configuration);Platform=AnyCPU;RuntimeIdentifier=win-x64;SelfContained=true;MSBuildIsRestoring=true" BuildInParallel="false" />
    <MSBuild Projects="@(Helper)" Targets="Publish" Properties="Configuration=$(Configuration);Platform=AnyCPU;RuntimeIdentifier=win-x64;SelfContained=true;PublishDir=$([System.IO.Path]::GetFullPath('$(OutDir)', '$(MSBuildProjectDirectory)'))%(Helper.Folder)\" BuildInParallel="false" />
  </Target>
  <Target Name="CopyHelpersToPublish" AfterTargets="Publish">
    <ItemGroup>
      <SpeechFile Include="$(OutDir)Speech\**" />
      <CleanupFile Include="$(OutDir)Cleanup\**" />
      <!-- Unpackaged WinUI publish leaves out the compiled XAML and resource index; without them the app crashes once its windows load. -->
      <XamlResource Include="$(OutDir)*.pri;$(OutDir)*.xbf" />
    </ItemGroup>
    <Copy SourceFiles="@(XamlResource)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(SpeechFile)" DestinationFiles="@(SpeechFile->'$(PublishDir)Speech\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(CleanupFile)" DestinationFiles="@(CleanupFile->'$(PublishDir)Cleanup\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Error Condition="!Exists('$(PublishDir)Cleanup\runtimes\win-x64\native\vulkan\ggml-vulkan.dll')"
           Text="Publish did not contain the Cleanup Vulkan backend (ggml-vulkan.dll)." />
  </Target>
</Project>
