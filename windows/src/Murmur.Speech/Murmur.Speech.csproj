<Project Sdk="Microsoft.NET.Sdk">
  <!-- The local speech helper: ModelBench's CLI and line protocol on sherpa-onnx (CPU).
       Publish per RID: dotnet publish windows/src/Murmur.Speech -c Release -r win-x64 (or osx-arm64). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Murmur.Speech</RootNamespace>
    <AssemblyName>MurmurSpeech</AssemblyName>
    <RuntimeIdentifiers>win-x64;osx-arm64</RuntimeIdentifiers>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="2.0.1" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-x64" Version="2.0.1" Condition="'$(RuntimeIdentifier)' == 'win-x64'" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.osx-arm64" Version="2.0.1" Condition="'$(RuntimeIdentifier)' == 'osx-arm64'" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Murmur.Core\Murmur.Core.csproj" />
  </ItemGroup>
  <Target Name="CopySherpaDirectML" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' == 'win-x64' and '$(MurmurSherpaDirectML)' != ''">
    <ItemGroup>
      <DirectMLRuntime Include="$(MurmurSherpaDirectML)/sherpa-onnx-c-api.dll;$(MurmurSherpaDirectML)/onnxruntime.dll;$(MurmurSherpaDirectML)/onnxruntime_providers_shared.dll;$(MurmurSherpaDirectML)/DirectML.dll" />
      <DirectMLNotice Include="$(MurmurSherpaDirectML)/licenses/*.txt" />
    </ItemGroup>
    <Copy SourceFiles="@(DirectMLRuntime)" DestinationFolder="$(PublishDir)" />
    <Copy SourceFiles="@(DirectMLNotice)" DestinationFolder="$(PublishDir)licenses" />
  </Target>
</Project>
